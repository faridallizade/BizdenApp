# The web container proxies /api to the API container, so no frontend API URL is needed.
# The only host port the stack opens. Change it if Windows reserves this port.
WEB_PORT=58081

# Server-side only. Add real values to your secret store, never commit them.
R2__Endpoint=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2__Bucket=bizden-media
R2__AccessKeyId=
R2__SecretAccessKey=
