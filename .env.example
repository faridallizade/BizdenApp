# The web container proxies /api to the API container, so no frontend API URL is needed.
# The only host port the stack opens. Use 127.0.0.1 on a VPS behind Cloudflare Tunnel.
# Keep 0.0.0.0 on a local Windows machine when LAN access is needed.
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=58081
ASPNETCORE_ENVIRONMENT=Development

# Production only: domain served by Caddy. Do not include http:// or https://.
PUBLIC_HOST=bizden.duckdns.org

# Server-side only. Add real values to your secret store, never commit them.
R2__Endpoint=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2__Bucket=bizden-media
R2__AccessKeyId=
R2__SecretAccessKey=

# Protects the Prometheus-compatible /metrics endpoint. Use a long random value in production.
Monitoring__MetricsApiKey=

# Email OTP delivery. Set these only in the production secret store.
Smtp__Host=smtp.example.com
Smtp__Port=587
Smtp__UserName=
Smtp__Password=
Smtp__From=no-reply@example.com
Smtp__FromName=Bizdən
Smtp__EnableSsl=true
